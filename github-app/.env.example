# ===========================================
# GitHub App Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# -------------------------------------------
# Required Variables
# -------------------------------------------

# GitHub App ID (from GitHub App settings page)
GITHUB_APP_ID=123456

# GitHub App private key (from GitHub App settings → Generate private key)
# Note: Replace newlines with \n for single-line format, or use multi-line with quotes
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# GitHub webhook secret (must match GITHUB_APP_SECRET in backend)
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# -------------------------------------------
# Optional Variables (have defaults)
# -------------------------------------------

# Backend API URL
BACKEND_API_URL=http://localhost:8000

# Backend API key for authentication (must match API_KEY in backend)
# BACKEND_API_KEY=optional-api-key

# Server port
PORT=3000

# Node environment
NODE_ENV=development

# Logging level
LOG_LEVEL=info
