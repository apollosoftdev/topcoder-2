# Enterprise Guardrails Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Backend Configuration
# ===========================================

# Anthropic Claude API Key (required for AI review)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Database URL for PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/guardrails

# GitHub App webhook secret (must match GitHub App settings)
GITHUB_APP_SECRET=your-webhook-secret

# Optional: API key for backend authentication
# BACKEND_API_KEY=your-secret-api-key

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ===========================================
# GitHub App Configuration
# ===========================================

# GitHub App ID (from GitHub App settings)
GITHUB_APP_ID=123456

# GitHub App private key (from GitHub App settings)
# Note: Replace newlines with \n for single-line format
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# GitHub webhook secret (must match GITHUB_APP_SECRET above)
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Backend API URL (for GitHub App to call)
# Use http://backend:8000 for Docker Compose
# Use https://your-backend.railway.app for Railway
BACKEND_API_URL=http://localhost:8000

# ===========================================
# Optional Configuration
# ===========================================

# Claude model to use (default: claude-sonnet-4-20250514)
# CLAUDE_MODEL=claude-sonnet-4-20250514

# Maximum diff size to analyze (default: 100000 characters)
# MAX_DIFF_SIZE=100000

# Default enforcement mode (advisory, warning, blocking)
# DEFAULT_ENFORCEMENT_MODE=warning
